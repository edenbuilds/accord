# Where to load your tools from. Copy it from your gateway page on mcp.edenbuilds.me,
# or leave empty and put a tools.json manifest next to server.mjs.
ACCORD_MANIFEST_URL=

# Your real API. API_BASE_URL overrides the base URL in the manifest.
API_BASE_URL=
API_TOKEN=

# The token your agent must send: Authorization: Bearer <token>. 24+ characters.
MCP_BEARER_TOKEN=

# Tools that change data are hidden unless this is true.
ALLOW_WRITES=false
